{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "colonizers",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // The web app is served from the same Worker, so the site and API share one
  // origin (no CORS, simple login cookies). Asset requests are free and do not
  // run the Worker; only /api/* does.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GameRoom" },
      // One object, named "main", holds accounts, crews and game history.
      { "name": "ACCOUNTS", "class_name": "Accounts" },
    ],
  },
  // Free plan only allows SQLite-backed Durable Objects.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Accounts"] },
  ],
  // Secrets (set with `wrangler secret put`, all optional):
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET for Google sign-in,
  // RESEND_API_KEY and EMAIL_FROM for sign-up and password emails,
  // ADMIN_EMAILS (comma-separated) for accounts that see admin details.
  "observability": { "enabled": true },
}
